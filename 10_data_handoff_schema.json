{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data Handoff Schema - Judge to Swarm",
  "description": "The strictly validated JSON payload generated by the deterministic Judge. This is the ONLY data the AI Swarm receives to generate esports commentary. The Swarm cannot execute trades.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "bot_id",
    "event_type",
    "current_state",
    "metrics"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for this specific handoff event."
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp of the event."
    },
    "bot_id": {
      "type": "string",
      "description": "The identifier of the competing algorithm."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "TRADE_EXECUTED",
        "TRADE_CLOSED",
        "REGIME_SHIFT",
        "GUILLOTINE_WARNING",
        "LIQUIDATED",
        "MATCH_CONCLUDED"
      ],
      "description": "The category of the event triggering the handoff."
    },
    "trigger_details": {
      "type": "object",
      "description": "Specific details related to the event_type.",
      "properties": {
        "reason": { "type": "string" },
        "slippage_bps": { "type": "number" },
        "fees_deducted": { "type": "number" }
      }
    },
    "current_state": {
      "type": "object",
      "required": ["is_liquidated", "current_drawdown_pct"],
      "properties": {
        "is_liquidated": {
          "type": "boolean",
          "description": "True if the bot has hit the -25% Guillotine threshold."
        },
        "current_drawdown_pct": {
          "type": "number",
          "description": "The current drawdown percentage from peak equity."
        },
        "trades_executed": {
          "type": "integer",
          "description": "Total number of trades executed so far (used for Freq-Penalty context)."
        },
        "current_regime": {
          "type": "string",
          "enum": ["HIGH_VOL_TREND", "LOW_VOL_CHOP", "RECOVERY", "UNKNOWN"],
          "description": "The deterministically identified market regime."
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["sortino_ratio", "current_score"],
      "properties": {
        "sortino_ratio": {
          "type": "number"
        },
        "current_score": {
          "type": "number",
          "description": "The current Battle-Royale formula score."
        },
        "freq_penalty_applied": {
          "type": "number"
        },
        "regime_resilience_bonus": {
          "type": "number"
        }
      }
    }
  }
}
