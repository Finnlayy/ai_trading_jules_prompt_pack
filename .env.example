AI_PROVIDER=moonshot

# Moonshot / Kimi K2.6
MOONSHOT_API_KEY=replace_with_your_moonshot_api_key
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6

# OpenAI / ChatGPT API
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# Google Gemini API via OpenAI-compatible endpoint
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-pro

# Broker mode: simulation, paper, pionex_relay, pionex_direct, glint, or ctrader.
# paper uses Bybit testnet only. pionex_relay sends to your local relay only when enabled below.
# glint routes perp trades through Hyperliquid via Telegram bot.
BROKER_MODE=simulation

# Pionex relay broker. Keep disabled during backtests until you intentionally deploy.
PIONEX_RELAY_ENABLED=false
PIONEX_RELAY_URL=http://127.0.0.1:5000/webhook
PIONEX_SIGNAL_BOT_UUID=replace_with_your_pionex_signal_bot_uuid
PIONEX_RELAY_CONTRACTS=1
PIONEX_RELAY_TIMEOUT_SECONDS=10

# Pionex direct broker (native REST execution)
PIONEX_DIRECT_ENABLED=false
PIONEX_DIRECT_LIVE_TRADING_ENABLED=false
PIONEX_API_KEY=replace_with_your_pionex_api_key
PIONEX_API_SECRET=replace_with_your_pionex_api_secret
PIONEX_DIRECT_BASE_URL=https://api.pionex.com
PIONEX_DIRECT_TIMEOUT_SECONDS=10
PIONEX_ALLOWED_SYMBOLS=BTC_USDT,BTC_USDT_PERP,ETH_USDT,ETH_USDT_PERP,HYPE_USDT,HYPE_USDT_PERP,XAG_USDT_PERP
PIONEX_DIRECT_DEFAULT_SPOT_SYMBOL=BTC_USDT
PIONEX_DIRECT_DEFAULT_FUTURES_SYMBOL=BTC_USDT_PERP
PIONEX_DIRECT_FUTURES_ENABLED=true
PIONEX_DIRECT_FUTURES_MODE=mode1
PIONEX_DIRECT_ALLOW_PAYLOAD_LEVERAGE=false

# cTrader Open API broker. Keep disabled unless intentionally testing this adapter.
CTRADER_ENABLED=false
CTRADER_LIVE_TRADING_ENABLED=false
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=0
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
CTRADER_SYMBOL_MAP_PATH=ctrader_symbols.json

# cTrader FIX API broker. Enabled exposes the adapter; live trading must remain false unless explicitly approved.
CTRADER_FIX_ENABLED=false
CTRADER_FIX_LIVE_TRADING_ENABLED=false
CTRADER_FIX_HOST=demo-uk-eqx-01.p.c-trader.com
CTRADER_FIX_PORT=5212
CTRADER_FIX_SENDER_COMP_ID=
CTRADER_FIX_TARGET_COMP_ID=cServer
CTRADER_FIX_PASSWORD=
CTRADER_FIX_SENDER_SUB_ID=TRADE

# GLINT broker (Hyperliquid perps via Telegram bot)
GLINT_ENABLED=false
GLINT_LIVE_TRADING_ENABLED=false
GLINT_TELEGRAM_CHAT_ID=
GLINT_BOT_USERNAME=

# Hyperliquid direct API (future — Way B)
# HYPERLIQUID_WALLET_ADDRESS=0x...
# HYPERLIQUID_PRIVATE_KEY=         # NEVER commit this

# Kelly sizing controls (direct broker)
KELLY_DEPLOY_MODE=half
KELLY_LOOKBACK_TRADES=50
KELLY_MIN_TRADES=20
KELLY_FIXED_RISK_PCT=1.0
KELLY_MIN_RISK_PCT=0.2
KELLY_MAX_RISK_PCT=2.0
KELLY_PAYOFF_BUFFER=0.0
PIONEX_DIRECT_MIN_ORDER_USDT=5
PIONEX_DIRECT_MAX_ORDER_USDT=200
PIONEX_DIRECT_MIN_BASE_SIZE=0.0001
PIONEX_DIRECT_MAX_BASE_SIZE=10

# Live-safety policy
AI_FAILURE_POLICY=reject_live
AI_TELEGRAM_ADVISORS_ENABLED=false
AI_TELEGRAM_ADVISOR_TIMEOUT_SECONDS=20

# Deterministic War Room order-management controls
WAR_ROOM_ENABLED=true
WAR_ROOM_CHOP_STANDBY_THRESHOLD=61.8
WAR_ROOM_HURST_HAZARD_THRESHOLD=0.45
WAR_ROOM_HARD_KILL_DRAWDOWN_PCT=25.0
WAR_ROOM_ORANGE_MAX_RISK_PCT=1.0
WAR_ROOM_AI_MIN_CONFIDENCE=0.55
WAR_ROOM_PENDING_ORDER_MAX_AGE_SECONDS=300
WAR_ROOM_VIP_CONFLUENCE_SCORE=85.0
WAR_ROOM_VIP_RELATIVE_VOLUME=1.5
WAR_ROOM_VIP_MAX_CRISIS_SCORE=15.0
WAR_ROOM_VIP_MAX_MC_DISPERSION=2.5

# Webhook authentication (TradingView → M8)
WEBHOOK_SECRET=

# Optional simulation/backtest helper. Leave empty for asset-calibrated defaults.
SIGNAL_MIN_CONFLUENCE_OVERRIDE=

# Telegram notifications (heartbeat, trade alerts, GLINT, Manus)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Manus advisor (separate Telegram chat from GLINT)
MANUS_ENABLED=false
MANUS_TELEGRAM_CHAT_ID=
MANUS_BOT_USERNAME=

# --- AI Training Academy ---
TRAINING_LOOP_ENABLED=true
TRAINING_LOOP_AUTO_START=false
TRAINING_LOOP_NIGHT_MODE=true
TRAINING_LOOP_NIGHT_START=22:00
TRAINING_LOOP_NIGHT_END=06:00
TRAINING_LOOP_DRILLS_PER_HOUR=12

# --- Scout Specific AI Providers ---
AI_PROVIDER_TECHNICAL=gemini
AI_PROVIDER_SENTIMENT=moonshot
AI_PROVIDER_RISK=openai
AI_PROVIDER_MACRO=gemini
AI_PROVIDER_EXECUTION=moonshot
AI_PROVIDER_CORRELATION=openai

# Kraken broker (spot crypto trading via REST API)
KRAKEN_ENABLED=false
KRAKEN_LIVE_TRADING_ENABLED=false
KRAKEN_API_KEY=replace_with_your_kraken_api_key
KRAKEN_API_SECRET=replace_with_your_kraken_api_secret
KRAKEN_TIMEOUT_SECONDS=20
KRAKEN_DEMO_MODE=true
KRAKEN_SPOT_ONLY=true
KRAKEN_MAX_ORDER_USD=100
KRAKEN_MIN_ORDER_USD=10
