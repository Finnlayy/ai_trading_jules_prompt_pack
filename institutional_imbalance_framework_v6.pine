//@version=6
// ═════════════════════════════════════════════════════════════════════════════
// Institutional Imbalance Framework — Educational Imitation (Pine Script v6)
// Inspired by Alien Algorithms' original framework.
// This is a simplified, open-source homage capturing the three core pillars:
// 1) CVMI  – Cumulative Volumetric Market Imbalance oscillator
// 2) SOMM  – Structural OrderBlock Mitigation Mechanism
// 3) Liquidity Matrix + Exhaustion / Sweep signal hooks + JSON alerts
// ═════════════════════════════════════════════════════════════════════════════
indicator("Institutional Imbalance Framework [Imitation v6]", shorttitle="IIF v6", overlay=true,
     max_bars_back=500, max_lines_count=500, max_boxes_count=100, max_labels_count=100)

// ═════════════════════════════════════════════════════════════════════════════
// CONFIGURATION
// ═════════════════════════════════════════════════════════════════════════════
grpFVG = "Fair Value Gaps"
fvgMinTicks = input.float(0.0, "Min FVG Size (ticks)", group=grpFVG, step=0.1)
fvgLookback = input.int(100, "FVG Lookback", group=grpFVG, minval=20, maxval=300)

grpCVMI = "CVMI Oscillator"
cvmiLen = input.int(50, "Normalization Lookback", group=grpCVMI, minval=10, maxval=200)
cvmiSmooth = input.int(3, "EMA Smoothing", group=grpCVMI, minval=1, maxval=20)
useVolWeight = input.bool(true, "Volume-Weighted Classification", group=grpCVMI)
cvmiMode = input.string("Normalized", "Display Mode", options=["Normalized", "Raw"], group=grpCVMI)

grpOB = "OrderBlocks"
obLookback = input.int(50, "OB Tracking Lookback", group=grpOB, minval=10, maxval=100)
showOBs = input.bool(true, "Show OrderBlocks", group=grpOB)
obMitigationThresh = input.float(50.0, "Exhaustion Mitigation %", group=grpOB, minval=0.0, maxval=100.0, step=5.0)

grpSig = "Signals"
exhaustHi = input.int(80, "Exhaustion: Overbought CVMI", group=grpSig, minval=50, maxval=100)
exhaustLo = input.int(20, "Exhaustion: Oversold CVMI", group=grpSig, minval=0, maxval=50)
sweepBars = input.int(2, "Sweep Reclaim Bars", group=grpSig, minval=1, maxval=5)

grpDisp = "Display"
showTrend = input.bool(true, "Trend Panel (bg)", group=grpDisp)
showSqueeze = input.bool(true, "Squeeze Candles", group=grpDisp)
showMatrix = input.bool(false, "Liquidity Matrix (table)", group=grpDisp)

grpAlert = "Alerts & Webhooks"
useAlerts = input.bool(true, "Enable Dynamic JSON Alerts", group=grpAlert)

// ═════════════════════════════════════════════════════════════════════════════
// UTILITIES
// ═════════════════════════════════════════════════════════════════════════════
avgVolume = ta.sma(volume, cvmiLen)

// Classify orderflow character: 0.0 = pure institutional, 1.0 = pure retail
// Institutional displacement = large body/range, high relative volume
flowScore(offset) =>
    body = math.abs(close[offset] - open[offset])
    range = high[offset] - low[offset]
    bodyRatio = range > 0 ? body / range : 0.0
    volRatio = avgVolume[offset] > 0 ? volume[offset] / avgVolume[offset] : 1.0
    inst = bodyRatio * 0.6 + math.min(volRatio / 2.5, 1.0) * 0.4
    1.0 - inst

// ═════════════════════════════════════════════════════════════════════════════
// FVG & CVMI ENGINE
// ═════════════════════════════════════════════════════════════════════════════
var float rawCVMI = 0.0
var float cvmiNorm = 50.0
var float cvmiEMA = 50.0

if bar_index > fvgLookback + 5
    float cum = 0.0
    float minTick = syminfo.mintick
    float minSize = fvgMinTicks * minTick

    for offset = 0 to fvgLookback
        // Bullish FVG confirmed at bar_index - offset
        float bullTop = low[offset]
        float bullBot = high[offset + 2]
        bool isBull = high[offset + 2] < low[offset] and (bullTop - bullBot) >= minSize

        // Bearish FVG confirmed at bar_index - offset
        float bearTop = low[offset + 2]
        float bearBot = high[offset]
        bool isBear = low[offset + 2] > high[offset] and (bearTop - bearBot) >= minSize

        float flow = flowScore(offset + 1)
        float weightMult = 1.0 + flow * 2.0  // retail adds more imbalance

        if isBull
            float size = bullTop - bullBot
            float weight = size * weightMult
            if close <= bullBot
                weight := 0.0
            else if close < bullTop
                weight := weight * ((close - bullBot) / size)
            cum += weight

        if isBear
            float size = bearTop - bearBot
            float weight = size * weightMult
            if close >= bearTop
                weight := 0.0
            else if close > bearBot
                weight := weight * ((bearTop - close) / size)
            cum -= weight

    rawCVMI := cum
    float maxAbs = ta.highest(math.abs(rawCVMI), cvmiLen)
    cvmiNorm := maxAbs > 0 ? 50.0 + (rawCVMI / maxAbs) * 50.0 : 50.0
    cvmiEMA := ta.ema(cvmiNorm, cvmiSmooth)

// ═════════════════════════════════════════════════════════════════════════════
// ORDERBLOCK ENGINE (Circular Buffer)
// ═════════════════════════════════════════════════════════════════════════════
MAX_OB = 20
var float[] obTop = array.new_float(MAX_OB, na)
var float[] obBot = array.new_float(MAX_OB, na)
var bool[] obBull = array.new_bool(MAX_OB, false)
var int[] obBar = array.new_int(MAX_OB, -1)
var float[] obMit = array.new_float(MAX_OB, 0.0)
var bool[] obAlive = array.new_bool(MAX_OB, false)
var int[] obSweep = array.new_int(MAX_OB, 0)      // 0=none, 1=swept, 2=reclaimed
var int[] obSweepBar = array.new_int(MAX_OB, -1)
var box[] obBox = array.new_box(MAX_OB, na)
var int obPtr = 0
var int obCnt = 0

// Detect new OB at current bar
bool newBullOB = high[2] < low[0] and close[2] < open[2] and (high[1] - low[1] > 0) and math.abs(close[1] - open[1]) / (high[1] - low[1]) > 0.5
bool newBearOB = low[2] > high[0] and close[2] > open[2] and (high[1] - low[1] > 0) and math.abs(close[1] - open[1]) / (high[1] - low[1]) > 0.5

if newBullOB or newBearOB
    box oldB = array.get(obBox, obPtr)
    if not na(oldB)
        box.delete(oldB)

    float top = newBullOB ? high[2] : high[2]
    float bot = newBullOB ? low[2] : low[2]
    color obColor = newBullOB ? color.new(color.green, 70) : color.new(color.red, 70)
    color borderCol = newBullOB ? color.green : color.red

    box b = na
    if showOBs
        b := box.new(left=bar_index - 2, top=top, right=bar_index, bottom=bot,
                 bgcolor=obColor, border_color=borderCol, border_width=1, extend=extend.right)

    array.set(obTop, obPtr, top)
    array.set(obBot, obPtr, bot)
    array.set(obBull, obPtr, newBullOB)
    array.set(obBar, obPtr, bar_index - 2)
    array.set(obMit, obPtr, 0.0)
    array.set(obAlive, obPtr, true)
    array.set(obSweep, obPtr, 0)
    array.set(obSweepBar, obPtr, -1)
    array.set(obBox, obPtr, b)

    obPtr := (obPtr + 1) % MAX_OB
    obCnt := math.min(obCnt + 1, MAX_OB)

// Update existing OBs each bar
if obCnt > 0
    for i = 0 to obCnt - 1
        int idx = (obPtr - 1 - i + MAX_OB) % MAX_OB
        if array.get(obAlive, idx)
            float top = array.get(obTop, idx)
            float bot = array.get(obBot, idx)
            bool bullish = array.get(obBull, idx)
            box b = array.get(obBox, idx)
            float mit = 0.0
            bool alive = true
            int sweep = array.get(obSweep, idx)
            int sweepBar = array.get(obSweepBar, idx)

            if bullish
                if high >= bot and low <= top
                    mit := math.min(100.0, (high - bot) / (top - bot) * 100.0)
                if high >= top
                    mit := 100.0
                if low < bot - (top - bot) * 0.5
                    alive := false
                // Sweep: close below bottom, reclaim within sweepBars
                if sweep == 0 and close < bot
                    sweep := 1
                    array.set(obSweepBar, idx, bar_index)
                if sweep == 1 and close >= bot
                    if bar_index - sweepBar <= sweepBars
                        sweep := 2
                    else
                        sweep := 0
                        array.set(obSweepBar, idx, -1)
            else
                if
