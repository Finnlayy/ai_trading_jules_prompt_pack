//@version=6
// ═════════════════════════════════════════════════════════════════════════════
// Institutional Imbalance Framework — Educational Imitation (Pine Script v6)
// Inspired by Alien Algorithms' original framework.
// Captures the three core pillars:
// 1) CVMI  – Cumulative Volumetric Market Imbalance oscillator
// 2) SOMM  – Structural OrderBlock Mitigation Mechanism
// 3) Liquidity Matrix + Exhaustion / Sweep signal hooks + JSON alerts
// ═════════════════════════════════════════════════════════════════════════════
indicator("Institutional Imbalance Framework [Imitation v6]", shorttitle="IIF v6", overlay=true,
     max_bars_back=500, max_lines_count=500, max_boxes_count=100, max_labels_count=100)

// ═════════════════════════════════════════════════════════════════════════════
// CONFIGURATION
// ═════════════════════════════════════════════════════════════════════════════
grpFVG = "Fair Value Gaps"
fvgMinTicks = input.float(0.0, "Min FVG Size (ticks)", group=grpFVG, step=0.1)
fvgLookback = input.int(100, "FVG Lookback", group=grpFVG, minval=20, maxval=300)

grpCVMI = "CVMI Oscillator"
cvmiLen = input.int(50, "Normalization Lookback", group=grpCVMI, minval=10, maxval=200)
cvmiSmooth = input.int(3, "EMA Smoothing", group=grpCVMI, minval=1, maxval=20)
useVolWeight = input.bool(true, "Volume-Weighted Classification", group=grpCVMI)
cvmiMode = input.string("Normalized", "Display Mode", options=["Normalized", "Raw"], group=grpCVMI)

grpOB = "OrderBlocks"
obLookback = input.int(50, "OB Tracking Lookback", group=grpOB, minval=10, maxval=100)
showOBs = input.bool(true, "Show OrderBlocks", group=grpOB)
obMitigationThresh = input.float(50.0, "Exhaustion Mitigation %", group=grpOB, minval=0.0, maxval=100.0, step=5.0)

grpSig = "Signals"
exhaustHi = input.int(80, "Exhaustion: Overbought CVMI", group=grpSig, minval=50, maxval=100)
exhaustLo = input.int(20, "Exhaustion: Oversold CVMI", group=grpSig, minval=0, maxval=50)
sweepBars = input.int(2, "Sweep Reclaim Bars", group=grpSig, minval=1, maxval=5)

grpDisp = "Display"
showTrend = input.bool(true, "Trend Panel (bg)", group=grpDisp)
showSqueeze = input.bool(true, "Squeeze Candles", group=grpDisp)
showMatrix = input.bool(false, "Liquidity Matrix (table)", group=grpDisp)

grpAlert = "Alerts & Webhooks"
useAlerts = input.bool(true, "Enable Dynamic JSON Alerts", group=grpAlert)

// ═════════════════════════════════════════════════════════════════════════════
// UTILITIES
// ═════════════════════════════════════════════════════════════════════════════
avgVolume = ta.sma(volume, cvmiLen)

// Classify orderflow character: 0.0 = pure institutional, 1.0 = pure retail
// Institutional displacement = large body/range, high relative volume
flowScore(offset) =>
    body = math.abs(close[offset] - open[offset])
    rng = high[offset] - low[offset]
    bodyRatio = rng > 0 ? body / rng : 0.0
    volRatio = avgVolume[offset] > 0 ? volume[offset] / avgVolume[offset] : 1.0
    inst = bodyRatio * 0.6 + math.min(volRatio / 2.5, 1.0) * 0.4
    1.0 - inst

// ═════════════════════════════════════════════════════════════════════════════
// FVG & CVMI ENGINE
// ═════════════════════════════════════════════════════════════════════════════
var float rawCVMI = 0.0
var float cvmiNorm = 50.0
var float cvmiEMA = 50.0

if bar_index > fvgLookback + 5
    float cum = 0.0
    float minTick = syminfo.mintick
    float minSize = fvgMinTicks * minTick

    for offset = 0 to fvgLookback
        // Bullish FVG confirmed at bar_index - offset
        float bullTop = low[offset]
        float bullBot = high[offset + 2]
        bool isBull = high[offset + 2] < low[offset] and (bullTop - bullBot) >= minSize

        // Bearish FVG confirmed at bar_index - offset
        float bearTop = low[offset + 2]
        float bearBot = high[offset]
        bool isBear = low[offset + 2] > high[offset] and (bearTop - bearBot) >= minSize

        float flow = flowScore(offset + 1)
        float weightMult = 1.0 + flow * 2.0  // retail adds more imbalance

        if isBull
            float size = bullTop - bullBot
            float weight = size * weightMult
            if close <= bullBot
                weight := 0.0
            else if close < bullTop
                weight := weight * ((close - bullBot) / size)
            cum += weight

        if isBear
            float size = bearTop - bearBot
            float weight = size * weightMult
            if close >= bearTop
                weight := 0.0
            else if close > bearBot
                weight := weight * ((bearTop - close) / size)
            cum -= weight

    rawCVMI := cum
    float maxAbs = ta.highest(math.abs(rawCVMI), cvmiLen)
    cvmiNorm := maxAbs > 0 ? 50.0 + (rawCVMI / maxAbs) * 50.0 : 50.0
    cvmiEMA := ta.ema(cvmiNorm, cvmiSmooth)

// ═════════════════════════════════════════════════════════════════════════════
// ORDERBLOCK ENGINE (Circular Buffer)
// ═════════════════════════════════════════════════════════════════════════════
MAX_OB = 20
var float[] obTop = array.new_float(MAX_OB, na)
var float[] obBot = array.new_float(MAX_OB, na)
var bool[] obBull = array.new_bool(MAX_OB, false)
var int[] obBar = array.new_int(MAX_OB, -1)
var float[] obMit = array.new_float(MAX_OB, 0.0)
var bool[] obAlive = array.new_bool(MAX_OB, false)
var int[] obSweep = array.new_int(MAX_OB, 0)      // 0=none, 1=swept, 2=reclaimed
var int[] obSweepBar = array.new_int(MAX_OB, -1)
var box[] obBox = array.new_box(MAX_OB, na)
var int obPtr = 0
var int obCnt = 0

// Detect new OB at current bar
bool newBullOB = high[2] < low[0] and close[2] < open[2] and (high[1] - low[1] > 0) and math.abs(close[1] - open[1]) / (high[1] - low[1]) > 0.5
bool newBearOB = low[2] > high[0] and close[2] > open[2] and (high[1] - low[1] > 0) and math.abs(close[1] - open[1]) / (high[1] - low[1]) > 0.5

if newBullOB or newBearOB
    box oldB = array.get(obBox, obPtr)
    if not na(oldB)
        box.delete(oldB)

    float top = newBullOB ? high[2] : high[2]
    float bot = newBullOB ? low[2] : low[2]
    color obColor = newBullOB ? color.new(color.green, 70) : color.new(color.red, 70)
    color borderCol = newBullOB ? color.green : color.red

    box b = na
    if showOBs
        b := box.new(left=bar_index - 2, top=top, right=bar_index, bottom=bot,
                 bgcolor=obColor, border_color=borderCol, border_width=1, extend=extend.right)

    array.set(obTop, obPtr, top)
    array.set(obBot, obPtr, bot)
    array.set(obBull, obPtr, newBullOB)
    array.set(obBar, obPtr, bar_index - 2)
    array.set(obMit, obPtr, 0.0)
    array.set(obAlive, obPtr, true)
    array.set(obSweep, obPtr, 0)
    array.set(obSweepBar, obPtr, -1)
    array.set(obBox, obPtr, b)

    obPtr := (obPtr + 1) % MAX_OB
    obCnt := math.min(obCnt + 1, MAX_OB)

// Update existing OBs each bar
if obCnt > 0
    for i = 0 to obCnt - 1
        int idx = (obPtr - 1 - i + MAX_OB) % MAX_OB
        if array.get(obAlive, idx)
            float top = array.get(obTop, idx)
            float bot = array.get(obBot, idx)
            bool bullish = array.get(obBull, idx)
            box b = array.get(obBox, idx)
            float mit = 0.0
            bool alive = true
            int sweep = array.get(obSweep, idx)
            int sweepBar = array.get(obSweepBar, idx)

            if bullish
                if high >= bot and low <= top
                    mit := math.min(100.0, (high - bot) / (top - bot) * 100.0)
                if high >= top
                    mit := 100.0
                if low < bot - (top - bot) * 0.5
                    alive := false
                // Sweep: close below bottom, reclaim within sweepBars
                if sweep == 0 and close < bot
                    sweep := 1
                    array.set(obSweepBar, idx, bar_index)
                if sweep == 1 and close >= bot
                    if bar_index - sweepBar <= sweepBars
                        sweep := 2
                    else
                        sweep := 0
                        array.set(obSweepBar, idx, -1)
            else
                if high >= bot and low <= top
                    mit := math.min(100.0, (top - low) / (top - bot) * 100.0)
                if low <= bot
                    mit := 100.0
                if high > top + (top - bot) * 0.5
                    alive := false
                if sweep == 0 and close > top
                    sweep := 1
                    array.set(obSweepBar, idx, bar_index)
                if sweep == 1 and close <= top
                    if bar_index - sweepBar <= sweepBars
                        sweep := 2
                    else
                        sweep := 0
                        array.set(obSweepBar, idx, -1)

            array.set(obMit, idx, mit)
            array.set(obAlive, idx, alive)
            array.set(obSweep, idx, sweep)

            // Update visuals only (extend=extend.right handles positioning automatically)
            if not na(b)
                if alive
                    if mit >= 100.0
                        box.set_bgcolor(b, color.new(color.gray, 80))
                        box.set_border_color(b, color.gray)
                    else
                        float intensity = 70.0 - (mit / 100.0) * 40.0
                        color base = bullish ? color.green : color.red
                        box.set_bgcolor(b, color.new(base, int(intensity)))
                        box.set_border_color(b, base)
                else
                    box.set_bgcolor(b, color.new(color.orange, 85))
                    box.set_border_color(b, color.orange)

// ═════════════════════════════════════════════════════════════════════════════
// SIGNALS
// ═════════════════════════════════════════════════════════════════════════════
bool sigExhaustBull = false
bool sigExhaustBear = false
bool sigSweepBull = false
bool sigSweepBear = false

if obCnt > 0
    for i = 0 to obCnt - 1
        int idx = (obPtr - 1 - i + MAX_OB) % MAX_OB
        if array.get(obAlive, idx)
            bool bullish = array.get(obBull, idx)
            float mit = array.get(obMit, idx)
            int sweep = array.get(obSweep, idx)

            // Block Exhaustion: extreme CVMI + OB tested + mitigation threshold
            if bullish and cvmiEMA > exhaustHi and mit >= obMitigationThresh
                sigExhaustBear := true
            if not bullish and cvmiEMA < exhaustLo and mit >= obMitigationThresh
                sigExhaustBull := true

            // Block Sweep: price swept OB edge and reclaimed
            if bullish and sweep == 2
                sigSweepBull := true
            if not bullish and sweep == 2
                sigSweepBear := true

// ═════════════════════════════════════════════════════════════════════════════
// SQUEEZE CANDLES (Momentum Extremes)
// ═════════════════════════════════════════════════════════════════════════════
float candleBody = math.abs(close - open)
float bodyMA = ta.sma(candleBody, 20)
float bodyStd = ta.stdev(candleBody, 20)
float atr14 = ta.atr(14)
bool squeeze = showSqueeze and candleBody > bodyMA + bodyStd * 2.0 and candleBody > atr14 * 0.6

// ═════════════════════════════════════════════════════════════════════════════
// LIQUIDITY MATRIX (Simplified Table)
// ═════════════════════════════════════════════════════════════════════════════
var table matrix = na
if showMatrix and barstate.islast
    if na(matrix)
        matrix := table.new(position.top_right, 3, 9, bgcolor=color.new(color.black, 10),
             frame_color=color.gray, frame_width=1)
        table.cell(matrix, 0, 0, "Price", text_color=color.white, text_size=size.small)
        table.cell(matrix, 1, 0, "Active", text_color=color.white, text_size=size.small)
        table.cell(matrix, 2, 0, "Filled", text_color=color.white, text_size=size.small)

    float recentHigh = ta.highest(high, 30)
    float recentLow = ta.lowest(low, 30)
    float step = (recentHigh - recentLow) / 8.0

    for row = 0 to 7
        float lvlTop = recentHigh - row * step
        float lvlBot = lvlTop - step
        int activeCount = 0
        int filledCount = 0
        for offset = 0 to 29
            // Bullish FVG in this level?
            if high[offset + 2] < low[offset]
                float bTop = low[offset]
                float bBot = high[offset + 2]
                if bTop > lvlBot and bBot < lvlTop
                    if close <= bBot
                        filledCount += 1
                    else
                        activeCount += 1
            // Bearish FVG in this level?
            if low[offset + 2] > high[offset]
                float bTop = low[offset + 2]
                float bBot = high[offset]
                if bTop > lvlBot and bBot < lvlTop
                    if close >= bTop
                        filledCount += 1
                    else
                        activeCount += 1
        table.cell(matrix, 0, row + 1, str.tostring((lvlTop + lvlBot) / 2.0, "#.#####"),
             text_color=color.gray, text_size=size.tiny)
        table.cell(matrix, 1, row + 1, str.tostring(activeCount),
             text_color=activeCount > 0 ? color.green : color.gray, text_size=size.tiny)
        table.cell(matrix, 2, row + 1, str.tostring(filledCount),
             text_color=filledCount > 0 ? color.red : color.gray, text_size=size.tiny)

// ═════════════════════════════════════════════════════════════════════════════
// PLOTTING
// ═════════════════════════════════════════════════════════════════════════════
// CVMI Oscillator (separate pane)
plot(cvmiMode == "Normalized" ? cvmiEMA : rawCVMI, title="CVMI",
     color=cvmiEMA > exhaustHi ? color.red : cvmiEMA < exhaustLo ? color.green : color.purple,
     linewidth=2, display=display.pane)
hline(exhaustHi, "Overbought", color=color.new(color.red, 50), linestyle=hline.style_dashed)
hline(exhaustLo, "Oversold", color=color.new(color.green, 50), linestyle=hline.style_dashed)
hline(50, "Equilibrium", color=color.gray)

// Trend Panel (heatmap bg on main chart)
color trendBg = na
if showTrend
    trendBg := cvmiEMA > 60 ? color.new(color.red, 95) : cvmiEMA < 40 ? color.new(color.green, 95) : na
bgcolor(trendBg, title="Structural Bias")

// Squeeze
plotshape(squeeze, title="Squeeze", location=location.abovebar, color=color.orange,
     style=shape.diamond, size=size.tiny, text="SZ")

// Signal shapes
plotshape(sigExhaustBear, title="Exhaustion (Bearish)", location=location.abovebar,
     color=color.red, style=shape.triangledown, size=size.small, text="EXH")
plotshape(sigExhaustBull, title="Exhaustion (Bullish)", location=location.belowbar,
     color=color.green, style=shape.triangleup, size=size.small, text="EXH")
plotshape(sigSweepBull, title="Sweep (Bullish)", location=location.belowbar,
     color=color.blue, style=shape.labelup, size=size.small, text="SWP")
plotshape(sigSweepBear, title="Sweep (Bearish)", location=location.abovebar,
     color=color.fuchsia, style=shape.labeldown, size=size.small, text="SWP")

// ═════════════════════════════════════════════════════════════════════════════
// ALERTS & JSON WEBHOOKS
// ═════════════════════════════════════════════════════════════════════════════
// Static alertconditions for manual UI alerts
alertcondition(sigExhaustBull, "IIF: Bullish Exhaustion", "Bullish Exhaustion on {{ticker}} @ {{close}}")
alertcondition(sigExhaustBear, "IIF: Bearish Exhaustion", "Bearish Exhaustion on {{ticker}} @ {{close}}")
alertcondition(sigSweepBull, "IIF: Bullish Sweep", "Bullish Sweep on {{ticker}} @ {{close}}")
alertcondition(sigSweepBear, "IIF: Bearish Sweep", "Bearish Sweep on {{ticker}} @ {{close}}")

// Dynamic JSON alerts via alert() function
if useAlerts
    string jsonPayload = '{"symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period +
         '","price":' + str.tostring(close) + ',"cvmi":' + str.tostring(cvmiEMA, "#.#") +
         ',"timestamp":' + str.tostring(time) + '}'
    if sigExhaustBull
        alert(jsonPayload + ',"signal":"EXHAUSTION_BULL"}', alert.freq_once_per_bar_close)
    if sigExhaustBear
        alert(jsonPayload + ',"signal":"EXHAUSTION_BEAR"}', alert.freq_once_per_bar_close)
    if sigSweepBull
        alert(jsonPayload + ',"signal":"SWEEP_BULL"}', alert.freq_once_per_bar_close)
    if sigSweepBear
        alert(jsonPayload + ',"signal":"SWEEP_BEAR"}', alert.freq_once_per_bar_close)
